PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=packswift
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-this-with-a-private-secret-at-least-32-characters
NODE_ENV=development
# Required for live visual itineraries: enable Places API (New) and billing.
# Server-only key. Never put this in public JS or commit a populated .env.
GOOGLE_PLACES_API_KEY=
# Optional conversational concierge keys; itinerary ordering itself is rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
RAPIDAPI_KEY=
EXCHANGERATE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
