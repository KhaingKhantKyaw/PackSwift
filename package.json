{
  "name": "packswift-travel-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered personal travel planning assistant.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:seed:destinations": "node scripts/db-seed-destinations.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^1.31.0",
    "mysql2": "^3.15.3",
    "sanitize-html": "^2.17.6"
  }
}
