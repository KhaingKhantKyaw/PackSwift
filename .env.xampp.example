# PackSwift local development with XAMPP MySQL
PORT=3000
HOST=127.0.0.1

# XAMPP normally uses port 3306 and a root account with no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=packswift
DB_CONNECTION_LIMIT=10

# Replace this value before using the application.
JWT_SECRET=replace-this-with-a-private-secret-at-least-32-characters
NODE_ENV=development
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
